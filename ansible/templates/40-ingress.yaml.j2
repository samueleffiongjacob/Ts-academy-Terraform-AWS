# k3s ships Traefik, which listens on port 80 of the nodes.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: web
  namespace: tsapp
spec:
  rules:
    - http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: frontend
                port:
                  number: 80
