apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
  namespace: tsapp
spec:
  replicas: 1
  selector:
    matchLabels:
      app: frontend
  template:
    metadata:
      labels:
        app: frontend
    spec:
      nodeSelector:
        role: frontend
      containers:
        - name: frontend
          image: tsapp-frontend:{{ frontend_tag }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 3000
          env:
            - name: BACKEND_URL
              value: "http://backend:{{ backend_port }}"
            - name: HOSTNAME   # Kubernetes would otherwise set this to the pod name
              value: "0.0.0.0"
          readinessProbe:
            httpGet:
              path: /
              port: 3000
            initialDelaySeconds: 5
            periodSeconds: 5
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              memory: 512Mi
---
apiVersion: v1
kind: Service
metadata:
  name: frontend
  namespace: tsapp
spec:
  selector:
    app: frontend
  ports:
    - port: 80
      targetPort: 3000
