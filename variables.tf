# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
variable "aws_region" {
  description = "AWS region to deploy into."
  type        = string
  default     = "eu-north-1"
}

variable "project_name" {
  description = "Short project name, used as a prefix for resource names."
  type        = string
  default     = "ts-academy"
}

variable "environment" {
  description = "Deployment environment."
  type        = string

  validation {
    condition     = contains(["dev", "staging", "prod"], var.environment)
    error_message = "environment must be one of: dev, staging, prod."
  }
}

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
variable "vpc_cidr" {
  description = "CIDR block for the VPC."
  type        = string
  default     = "10.0.0.0/16"

  validation {
    condition     = can(cidrhost(var.vpc_cidr, 0))
    error_message = "vpc_cidr must be a valid CIDR block."
  }
}

variable "availability_zones" {
  description = "Two AZs. The first hosts the public/private subnets; both host database subnets."
  type        = list(string)
  default     = ["eu-north-1a", "eu-north-1b"]

  validation {
    condition     = length(var.availability_zones) >= 2
    error_message = "Provide at least two availability zones (required by RDS subnet groups)."
  }
}

variable "enable_nat_gateway" {
  description = "Create a NAT gateway so private instances can reach the internet (costs money)."
  type        = bool
  default     = true
}

variable "ssh_allowed_cidrs" {
  description = "CIDRs allowed to SSH to the frontend server. Leave empty to disable SSH."
  type        = list(string)
  default     = ["0.0.0.0/0"]
  # default     = []
}

variable "backend_port" {
  description = "Port the backend application listens on."
  type        = number
  # default     = 443
  default     = 8080
}

# ---------------------------------------------------------------------------
# Compute
# ---------------------------------------------------------------------------
variable "ami_name_filter" {
  description = "Name filter for the Canonical Ubuntu AMI."
  type        = string
  default     = "ubuntu/images/hvm-ssd-gp3/ubuntu-resolute-26.04-amd64-server-*"
}

variable "frontend_instance_type" {
  description = "Instance type for the frontend server."
  type        = string
  default     = "m7i-flex.large"
}

variable "backend_instance_type" {
  description = "Instance type for the backend server."
  type        = string
  default     = "m7i-flex.large"
}

variable "root_volume_size" {
  description = "Root EBS volume size (GiB) for EC2 instances."
  type        = number
  default     = 30
}

# variable "key_name" {
#   description = "Existing EC2 key pair name for SSH access (null for none)."
#   type        = string
#   default     = null
# }

variable "key_name" {
  description = "EC2 key pair name (without .pem): an existing one, or the name to create when create_key_pair = true."
  type        = string
  default     = "devop-aws-ssh"
}

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
variable "db_name" {
  description = "Initial database name."
  type        = string
  default     = "my_ts_db"
}

variable "db_username" {
  description = "Master username. The password is generated by RDS and stored in Secrets Manager."
  type        = string
  default     = "mytsuser"
}

variable "db_engine_version" {
  description = "MySQL engine version (also used to pick the default parameter group)."
  type        = string
  default     = "8.4"
}

variable "db_instance_class" {
  description = "RDS instance class."
  type        = string
  default     = "db.t3.micro"
}

variable "db_allocated_storage" {
  description = "Allocated storage in GiB (MySQL minimum is 20)."
  type        = number
  default     = 20

  validation {
    condition     = var.db_allocated_storage >= 20
    error_message = "RDS MySQL requires at least 20 GiB."
  }
}

variable "db_multi_az" {
  description = "Run RDS in Multi-AZ mode."
  type        = bool
  default     = false
}

variable "db_backup_retention_days" {
  description = "Days to keep automated backups (0 disables them)."
  type        = number
  default     = 1
}

variable "db_deletion_protection" {
  description = "Prevent accidental deletion of the database."
  type        = bool
  default     = false
}

variable "db_skip_final_snapshot" {
  description = "Skip the final snapshot on destroy."
  type        = bool
  default     = true
}

# ---------------------------------------------------------------------------
# SSH key + Ansible deployment
# ---------------------------------------------------------------------------
variable "ssh_user" {
  description = "Login user of the Ubuntu AMI."
  type        = string
  default     = "ubuntu"
}

variable "ssh_private_key_path" {
  description = "Path to devop-aws-ssh.pem on the machine running terraform/ansible (a WSL path, chmod 400)."
  type        = string
  default     = "~/.ssh/devop-aws-ssh.pem"
}

variable "create_key_pair" {
  description = "false: key_name already exists in AWS. true: create it from ssh_public_key_path."
  type        = bool
  default     = false
}

variable "ssh_public_key_path" {
  description = "Public key to upload when create_key_pair = true. Make it with: ssh-keygen -y -f ~/.ssh/devop-aws-ssh.pem > ~/.ssh/devop-aws-ssh.pub"
  type        = string
  default     = "~/.ssh/devop-aws-ssh.pub"
}

variable "run_ansible" {
  description = "Run the Ansible playbook automatically once the servers exist."
  type        = bool
  default     = true
}
